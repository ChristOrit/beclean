---
import Img from '../components/Img.astro';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout
  title="À propos | Be Clean - Paysagiste Cotonou"
  description="Découvrez Be Clean, paysagiste à Cotonou depuis 2013. Notre histoire, notre équipe et nos valeurs."
>
  <PageHeader
    badge="À propos"
    title="Be Clean, votre paysagiste à Cotonou"
    accent="depuis 2013"
    description="Société de jardinage et d'aménagement paysager au Bénin : des jardiniers paysagistes professionnels dédiés à transformer vos extérieurs en havres de paix."
  />

  <section class="section-padding bg-white">
    <div class="container-custom grid items-center gap-10 lg:grid-cols-2">
      <div class="reveal">
        <span class="eyebrow">Qui sommes-nous</span>
        <p class="mt-5 text-lg leading-relaxed text-gray-600">
          Société de jardinage et d'aménagement paysager en Bénin, Be Clean est une équipe de
          jardiniers paysagistes professionnels dédiés à transformer vos espaces en véritables
          havres de paix.
        </p>
        <p class="mt-5 leading-relaxed text-gray-600">
          Basés à Cotonou, nous mettons notre expertise du climat tropical béninois au service de
          particuliers, entreprises et hôtels pour créer et entretenir des jardins d'exception.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/realisations" class="btn-primary justify-center">Voir nos réalisations</a>
          <a href="/devis" class="chip-link">Demander un devis</a>
        </div>
      </div>
      <div class="reveal">
        <div class="relative overflow-hidden rounded-3xl shadow-[0_36px_70px_-42px_rgb(16_24_40/0.5)]">
          <Img
            src="/assets/img/photo-1585320806297-9794b3e4eeae.jpg"
            alt="Jardin tropical entretenu à Cotonou"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          width="1200" height="900" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <span class="eyebrow reveal justify-center">Notre vision</span>
      <h2 class="reveal mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Transformer chaque espace extérieur en havre de sérénité</h2>
      <span class="rule-leaf reveal mx-auto mt-5"></span>
      <p class="reveal text-lg text-gray-600 leading-relaxed">
        Transformer chaque espace extérieur en un havre de beauté et de sérénité, voilà notre crédo. Nous croyons que les paysages bien conçus ont le pouvoir de créer des environnements qui inspirent, nourrissent et ravissent l'âme. <strong>Chaque projet que nous entreprenons vise l'harmonie entre l'homme et la nature.</strong>
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center reveal">
        <span class="eyebrow justify-center">Nos valeurs</span>
        <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Ce qui guide nos paysagistes</h2>
        <p class="mt-4 text-gray-600">Qualité, passion et personnalisation guident chacune de nos actions.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger">
        <div class="reveal card-lift bg-white rounded-xl p-6 text-center">
          <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Excellence</h3>
          <p class="text-gray-600 text-sm">Nous visons la perfection dans chaque projet, avec des matériaux de qualité et un savoir-faire exceptionnel.</p>
        </div>
        <div class="reveal card-lift bg-white rounded-xl p-6 text-center">
          <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Passion</h3>
          <p class="text-gray-600 text-sm">Notre amour du jardinage et de la nature se reflète dans chaque création.</p>
        </div>
        <div class="reveal card-lift bg-white rounded-xl p-6 text-center">
          <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Personnalisation</h3>
          <p class="text-gray-600 text-sm">Chaque projet est unique, nous écoutons et réalisons vos visions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-forest relative overflow-hidden text-white">
    <svg class="leaf-decor leaf-decor-gold absolute -left-16 -bottom-24 w-64 -rotate-12" viewBox="0 0 200 200" fill="currentColor" aria-hidden="true">
      <path d="M100 8c42 26 66 62 66 104 0 42-30 76-66 80-36-4-66-38-66-80C34 70 58 34 100 8zm0 24c-28 20-44 48-44 78 0 30 18 54 44 58 26-4 44-28 44-58 0-30-16-58-44-78z" />
    </svg>

    <div class="container-custom relative stagger py-16 text-center md:py-20">
      <span class="eyebrow eyebrow-light reveal justify-center">Ils nous font confiance</span>
      <h2 class="mt-3 text-3xl font-bold md:text-4xl">Ils nous ont confié leur espace vert</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-white/75">
        Hôtels, résidences, cabinets médicaux et promoteurs immobiliers à Cotonou travaillent avec nos équipes depuis plusieurs années.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 md:gap-x-16">
        <div class="reveal"><div class="font-display text-2xl font-bold text-accent-400">Azaléa Hôtel</div><div class="text-sm text-white/60">Hôtellerie</div></div>
        <div class="reveal"><div class="font-display text-2xl font-bold text-accent-400">Résidence Golf</div><div class="text-sm text-white/60">Résidentiel</div></div>
        <div class="reveal"><div class="font-display text-2xl font-bold text-accent-400">Cocotier Immo</div><div class="text-sm text-white/60">Promotion immobilière</div></div>
        <div class="reveal"><div class="font-display text-2xl font-bold text-accent-400">Clinique La Palmeraie</div><div class="text-sm text-white/60">Santé</div></div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center reveal">
        <span class="eyebrow justify-center">Nos engagements</span>
        <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Notre façon de travailler</h2>
        <span class="rule-leaf mx-auto mt-5 block"></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger">
        <div class="reveal card-lift bg-gray-50 rounded-xl p-6 text-center">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Équipe Qualifiée</h3>
          <p class="text-gray-600 text-sm">Professionnels hautement qualifiés, alliant compétence et passion.</p>
        </div>
        <div class="reveal card-lift bg-gray-50 rounded-xl p-6 text-center">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Matériaux Spécifiques</h3>
          <p class="text-gray-600 text-sm">Équipements de pointe adaptés à chaque tâche.</p>
        </div>
        <div class="reveal card-lift bg-gray-50 rounded-xl p-6 text-center">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Approche Personnalisée</h3>
          <p class="text-gray-600 text-sm">Chaque projet est unique, nous écoutons et réalisons vos visions.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Travaillons ensemble"
    subtitle="Prêt à transformer votre espace extérieur ? Contactez notre équipe pour discuter de votre projet."
    primaryText="Devis gratuit"
    primaryHref="/devis"
    secondaryText="Nous contacter"
    secondaryHref="/contact"
  />
</Layout>
