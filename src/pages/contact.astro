---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import PageHeader from '../components/PageHeader.astro';
import FAQ from '../components/FAQ.astro';
import FormScript from '../components/FormScript.astro';

const faqItems = [
  {
    question: 'Dans quelles communes intervenez-vous ?',
    answer:
      'Nous couvrons tout le département du Littoral : Cotonou, Abomey-Calavi, Sèmè-Podji, Ouidah, Grand-Popo et Porto-Novo. Nous nous déplaçons aussi à Parakou, Bohicon et Abomey pour les chantiers de plus de 500 m².',
  },
  {
    question: 'Sous quel délai pouvez-vous passer ?',
    answer:
      'Pour une urgence (arbre à abattre, débroussaillage, traitement), nous passons sous 24 à 48 heures. Pour un projet d’aménagement, la visite technique est planifiée sous 48 heures après votre appel.',
  },
  {
    question: 'La première consultation est-elle payante ?',
    answer:
      'Non. L’appel, la visite technique et le devis sont gratuits et sans engagement. Vous payez uniquement après validation du devis et signature du bon de commande.',
  },
  {
    question: 'Quels sont vos horaires ?',
    answer:
      'Nos équipes sont joignables du lundi au vendredi de 8h à 18h et le samedi de 9h à 13h. Sur WhatsApp, un chargé d’affaires répond généralement en moins d’une heure pendant ces créneaux.',
  },
];

const cards = [
  {
    title: 'Téléphone',
    body: '<a href="tel:+2290167592319" class="inline-block py-3 font-semibold text-primary-700 hover:text-primary-800 hover:underline">+229 01 67 59 23 19</a><br /><span class="text-sm text-gray-500">Appel direct, 7j/7 pour les urgences</span>',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  },
  {
    title: 'Email',
    body: '<a href="mailto:oritchrist@gmail.com" class="inline-block py-3 font-semibold text-primary-700 hover:text-primary-800 hover:underline break-all">oritchrist@gmail.com</a><br /><span class="text-sm text-gray-500">Réponse sous 24 h ouvrées</span>',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    title: 'Horaires',
    body: 'Lun – Ven : 08h00 – 18h00<br />Sam : 09h00 – 13h00<br /><span class="text-sm text-gray-500">Urgences par téléphone le dimanche</span>',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Adresse',
    body: 'Rue 12.045, Haie Vive<br />Cotonou, Bénin<br /><span class="text-sm text-gray-500">Interventions : Cotonou, Abomey-Calavi, Porto-Novo, Parakou</span>',
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z|M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  },
];
---

<Layout
  title="Contact | Be Clean - Paysagiste Cotonou"
  description="Contactez Be Clean, paysagiste à Cotonou. Téléphone : +229 01 67 59 23 19. Email : oritchrist@gmail.com. Devis gratuit, réponse sous 24h."
>
  <PageHeader
    badge="Contact"
    title="Contactez votre paysagiste à Cotonou"
    accent="réponse sous 24h"
    description="Téléphone, WhatsApp, email ou formulaire : notre équipe de jardiniers paysagistes vous répond sous 24 heures et se déplace dans tout le département du Littoral."
  />

  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="stagger">
          <div class="reveal mb-7">
            <span class="eyebrow">Nos coordonnées</span>
            <h2 class="mt-3 text-2xl font-bold text-gray-900 md:text-3xl">Parlons de votre espace vert</h2>
            <span class="rule-leaf mt-5 block"></span>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            {
              cards.map((card) => (
                <div class="reveal card-lift rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
                  <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-primary-600 to-primary-800 text-white shadow-[0_10px_20px_-12px_rgba(45,100,40,0.7)]">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      {card.icon.split('|').map((d) => (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d} />
                      ))}
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-gray-900">{card.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-gray-600" set:html={card.body} />
                </div>
              ))
            }
          </div>

          <div class="reveal mt-5 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <h3 class="text-base font-semibold text-gray-900">Contact rapide</h3>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
              <a href="tel:+2290167592319" class="btn-primary flex flex-1 cursor-pointer items-center justify-center gap-2">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                Appeler
              </a>
              <a href="https://wa.me/22967592319?text=Bonjour%20Be%20Clean" target="_blank" rel="noopener" class="btn-ghost flex flex-1 cursor-pointer items-center justify-center gap-2 !text-gray-800 hover:!text-primary-800">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /><path d="M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.463-8.413z" /></svg>
                WhatsApp
              </a>
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">Cotonou</span>
              <span class="rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">Abomey-Calavi</span>
              <span class="rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">Porto-Novo</span>
              <span class="rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">Sèmè-Podji</span>
            </div>
          </div>
        </div>

        <div>
          <form id="contact-form" data-lead-form data-endpoint="/api/contact" data-kind="Message" class="reveal overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-[0_18px_50px_-30px_rgba(15,46,30,0.45)]">
            <div class="border-b border-gray-100 bg-gradient-to-br from-primary-50 to-white px-6 py-7 md:px-8">
              <span class="eyebrow">Écrivez-nous</span>
              <h2 class="mt-3 text-2xl font-bold text-gray-900">Envoyez-nous un message</h2>
              <p class="mt-3 text-sm leading-relaxed text-gray-600">
                Une question, un projet, une demande d'entretien ? Nous vous répondons sous 24 heures ouvrées.
              </p>
            </div>

            <div class="space-y-6 px-6 py-7 md:px-8">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block text-sm font-semibold text-gray-700">Nom *</label>
                  <input type="text" id="name" name="name" required class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="Votre nom" />
                </div>
                <div>
                  <label for="phone" class="mb-2 block text-sm font-semibold text-gray-700">Téléphone *</label>
                  <input type="tel" id="phone" name="phone" required class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="+229 01 67 59 23 19" />
                </div>
              </div>

              <div>
                <label for="service" class="mb-2 block text-sm font-semibold text-gray-700">Service</label>
                <select id="service" name="service" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500">
                  <option value="">Choisir un service</option>
                  <option value="conception">Conception paysagère</option>
                  <option value="creation">Création de jardins</option>
                  <option value="renovation">Rénovation de jardins</option>
                  <option value="entretien">Entretien espaces verts</option>
                  <option value="traitement">Traitement phytosanitaire</option>
                </select>
              </div>

              <div>
                <label for="message" class="mb-2 block text-sm font-semibold text-gray-700">Message *</label>
                <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="Votre message..."></textarea>
              </div>

              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
              <input type="hidden" name="ts" value="" />

              <div>
                <button type="submit" data-submit class="btn-primary group flex w-full cursor-pointer items-center justify-center gap-2 !py-3.5 text-base">
                  <span data-submit-label>Envoyer le message</span>
                  <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </button>
                <div data-form-status hidden class="mt-4"></div>
                <p class="mt-4 flex items-start gap-2 text-sm text-gray-500">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                  Vos données restent confidentielles et ne servent qu'à vous répondre.
                </p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <FAQ
    eyebrow="Avant de nous écrire"
    title="Questions fréquentes sur notre contact"
    subtitle="Zones d'intervention, délais et gratuité : tout ce qu'il faut savoir avant de nous joindre."
    items={faqItems}
  />

  <CTA
    title="Besoin d'un paysagiste rapidement à Cotonou ?"
    subtitle="Appelez-nous directement ou contactez-nous sur WhatsApp pour une réponse immédiate."
    primaryText="Appeler maintenant"
    primaryHref="tel:+2290167592319"
    secondaryText="WhatsApp"
    secondaryHref="https://wa.me/22967592319"
  />
<FormScript />
</Layout>

