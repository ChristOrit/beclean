---
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services.js';

const faqItems = [
  {
    question: "Comment savoir si j'ai besoin d'une conception ou directement d'une réalisation ?",
    answer: "Si vous n'avez pas encore de vision claire de votre projet ou si vous souhaitez explorer différentes options, commencez par notre service de conception. Si vous savez exactement ce que vous voulez, nous pouvons passer directement à la réalisation.",
  },
  {
    question: "Proposez-vous des contrats d'entretien régulier ?",
    answer: "Oui, nous proposons des contrats d'entretien personnalisés (hebdomadaires, bimensuels ou mensuels) adaptés à la taille de votre espace et à vos besoins spécifiques.",
  },
  {
    question: "Intervenez-vous sur toute la Bénin ?",
    answer: "Nous intervenons principalement à Cotonou (Cotonou, Abomey-Calavi, Porto-Novo, Parakou...) et dans ses environs, mais nous pouvons étudier des projets dans d'autres régions de Bénin.",
  },
];
---

<Layout
  title="Services paysagiste Cotonou | Be Clean"
  description="Services de paysagiste à Cotonou : conception 3D, création de jardins, rénovation, entretien et traitement. Devis gratuit."
>
  <PageHeader
    badge="Nos Services"
    title="Nos services de paysagiste et jardinier à Cotonou"
    description="De la conception à l'entretien, notre équipe de jardiniers paysagistes à Cotonou offre une gamme complète de services d'aménagement paysager. Chaque projet est unique et mérite une attention particulière."
  />

  <section class="section-warm section-padding">
    <div class="container-custom">
      <div class="reveal mb-10 text-center md:mb-12">
        <span class="eyebrow justify-center">5 prestations clés en main</span>
        <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Du premier croquis au dernier passage d'entretien</h2>
      </div>

      <div class="stagger grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <a href={`/services/${service.slug}`} class="reveal group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white transition-all duration-300 hover:-translate-y-1.5 hover:border-accent-500/50 hover:shadow-[0_28px_56px_-32px_rgb(16_24_40/0.45)]">
            <div class="relative aspect-[16/10] overflow-hidden bg-primary-100">
              <Img
                src={service.image}
                alt={service.shortTitle}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
              width="1200" height="800" />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-950/55 via-gray-950/10 to-transparent" aria-hidden="true"></div>
              <span class="absolute bottom-3 left-3 rounded-full bg-white/95 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary-800">
                {service.shortTitle}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-xl text-gray-900 transition-colors group-hover:text-primary-700">
                {service.shortTitle}
              </h3>
              <span class="mt-3 block h-px w-10 bg-accent-500 transition-all duration-300 group-hover:w-16" aria-hidden="true"></span>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">{service.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">
                Découvrir ce service
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqItems} subtitle="Comment choisir le bon service pour votre projet ?" />

  <CTA
    title="Besoin d'un conseil personnalisé ?"
    subtitle="Contactez-nous pour discuter de votre projet. Nous vous aiderons à choisir les services les plus adaptés à vos besoins et à votre budget."
  />
</Layout>
