---
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';

const faqItems = [
  {
    question: 'Combien coûte un aménagement paysager ?',
    answer:
      "Le budget dépend de la surface, du type de végétation et des ouvrages (gazon, dalles, arrosage). Comptez à partir de 150 000 FCFA pour une mise en point vert, à partir de 500 000 FCFA pour une création complète de jardin, et à partir de 75 000 FCFA par mois pour un contrat d'entretien. Le devis détaillé est gratuit et détaillé ligne par ligne.",
  },
  {
    question: 'Sous quel délai recevez-nous le devis ?',
    answer:
      'Vous recevez une première estimation chiffrée sous 24 heures ouvrées après réception de votre demande. Une visite technique sur site est proposée ensuite, sous 48 heures à Cotonou et dans le département du Littoral, afin de figer le prix final.',
  },
  {
    question: 'Le devis et la visite sont-ils vraiment gratuits ?',
    answer:
      'Oui. La visite technique, la conception du plan et le chiffrage sont entièrement gratuits et sans engagement. Vous ne payez qu’après validation du devis et signature du bon de commande.',
  },
  {
    question: 'Intervenez-vous en dehors de Cotonou ?',
    answer:
      'Nos équipes interviennent dans tout le département du Littoral : Cotonou, Abomey-Calavi, Sèmè-Podji, Ouidah et Porto-Novo. Nous nous déplaçons également à Parakou et au reste du Bénin pour les projets de plus de 500 m².',
  },
  {
    question: 'Que se passe-t-il après l’envoi de ma demande ?',
    answer:
      'Un chargé d’affaires vous rappelle sous 24 h pour cadrer votre projet, puis un paysagiste se déplace pour prendre les mesures. Vous recevez ensuite le plan, le planning et le devis détaillé. Le chantier démarre en moyenne 7 à 15 jours après validation.',
  },
];

const steps = [
  { n: '01', t: 'Vous décrivez', d: 'Formulaire en 2 minutes : surface, service souhaité, envies.' },
  { n: '02', t: 'Nous vous rappelons', d: 'Un chargé d’affaires vous contacte sous 24 h ouvrées.' },
  { n: '03', t: 'Visite technique', d: 'Prise de mesures sur site, gratuite et sans engagement.' },
  { n: '04', t: 'Devis + plan', d: 'Chiffrage détaillé, plan d’aménagement et planning.' },
];
---

<Layout
  title="Devis gratuit paysagiste à Cotonou | Be Clean"
  description="Devis gratuit pour votre aménagement paysager à Cotonou : réponse sous 24 h, visite technique offerte et sans engagement."
>
  <PageHeader
    badge="Devis gratuit"
    title="Devis paysagiste à Cotonou"
    accent="réponse sous 24h"
    description="Décrivez votre projet en 2 minutes : nous vous répondons sous 24 heures avec une estimation précise, gratuite et sans engagement."
  />

  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <form id="devis-form" class="reveal overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-[0_18px_50px_-30px_rgba(15,46,30,0.45)]">
            <div class="border-b border-gray-100 bg-gradient-to-br from-primary-50 to-white px-6 py-7 md:px-9">
              <span class="eyebrow">Votre projet</span>
              <h2 class="mt-3 text-2xl font-bold text-gray-900 md:text-3xl">Parlez-nous de votre espace vert</h2>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full border border-primary-200 bg-white px-3 py-1 text-xs font-semibold text-primary-700">100 % gratuit</span>
                <span class="rounded-full border border-primary-200 bg-white px-3 py-1 text-xs font-semibold text-primary-700">Sans engagement</span>
                <span class="rounded-full border border-primary-200 bg-white px-3 py-1 text-xs font-semibold text-primary-700">Réponse sous 24 h</span>
              </div>
            </div>

            <div class="space-y-6 px-6 py-7 md:px-9">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block text-sm font-semibold text-gray-700">Nom complet *</label>
                  <input type="text" id="name" name="name" required class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="Votre nom" />
                </div>
                <div>
                  <label for="phone" class="mb-2 block text-sm font-semibold text-gray-700">Téléphone *</label>
                  <input type="tel" id="phone" name="phone" required class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="+229 01 67 59 23 19" />
                </div>
              </div>

              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                  <label for="service" class="mb-2 block text-sm font-semibold text-gray-700">Service souhaité *</label>
                  <select id="service" name="service" required class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500">
                    <option value="">Sélectionnez un service</option>
                    <option value="conception">Conception paysagère et modélisation 3D</option>
                    <option value="creation">Création de jardins tropicaux</option>
                    <option value="renovation">Rénovation de jardins</option>
                    <option value="entretien">Entretien d'espaces verts</option>
                    <option value="traitement">Traitement phytosanitaire</option>
                    <option value="arrosage">Système d'arrosage automatique</option>
                    <option value="autre">Autre</option>
                  </select>
                </div>
                <div>
                  <label for="zone" class="mb-2 block text-sm font-semibold text-gray-700">Commune / zone</label>
                  <input type="text" id="zone" name="zone" class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="Cotonou, Haie Vive…" />
                </div>
              </div>

              <div>
                <label for="message" class="mb-2 block text-sm font-semibold text-gray-700">Décrivez votre projet *</label>
                <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500" placeholder="Surface approximative, envies, contraintes, délais souhaités…"></textarea>
              </div>

              <div>
                <button type="submit" class="btn-primary group flex w-full cursor-pointer items-center justify-center gap-2 !py-3.5 text-base">
                  Envoyer ma demande de devis
                  <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </button>
                <p class="mt-4 flex items-start gap-2 text-sm text-gray-500">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                  Vos informations restent strictement confidentielles et ne servent qu'à préparer votre devis.
                </p>
              </div>
            </div>
          </form>
        </div>

        <div class="stagger space-y-6">
          <div class="reveal section-forest relative overflow-hidden rounded-2xl p-6 text-white md:p-7">
            <span class="eyebrow eyebrow-light">Pourquoi Be Clean</span>
            <h3 class="mt-3 text-xl font-bold">Nos engagements de devis</h3>
            <ul class="mt-5 space-y-3 text-sm">
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Devis gratuit et détaillé sous 24 h</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>13+ ans d'expérience à Cotonou</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Végétaux adaptés au climat tropical</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Garantie 3 mois sur les plantations</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Suivi personnalisé après chantier</span>
              </li>
            </ul>
          </div>

          <div class="reveal card-lift rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-gray-900">Besoin d'une réponse immédiate ?</h3>
            <p class="mt-2 text-sm text-gray-600">Lun – Ven : 8h – 18h<br />Sam : 9h – 13h</p>
            <div class="mt-4 space-y-3">
              <a href="tel:+2290167592319" class="btn-primary flex w-full cursor-pointer items-center justify-center gap-2">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                01 67 59 23 19
              </a>
              <a href="https://wa.me/22967592319?text=Bonjour%20Be%20Clean%2C%20je%20souhaite%20un%20devis" target="_blank" rel="noopener" class="btn-ghost flex w-full cursor-pointer items-center justify-center gap-2 !text-gray-800 hover:!text-primary-800">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-.1-1.161.242-.579.487-.5-.669-.51-.173-.008-.371-.007-.547-.001l-.198.032c-.492.177-.844.456-1.05.826l-.145.27c-.173.334-.347.668-.512 1.005-1.664.445-2.875.793-3.627 1.138l-.206-.126c-.255-.152-.494-.119-.666.068l-.14.144c-.446.447-.798.806-1.067 1.088l-.126.134c-.173.181-.26.423-.26.732 0 .308.086.546.26.717l.168.163c.667.656 1.585 1.167 2.756 1.53l.216.067c.46.14.87.114 1.226-.077.4-.217.702-.59.946-1.146.294-.664.496-1.435.605-2.404.084-.74.107-1.32.07-1.74-.03-.36-.16-.6-.39-.71z" /><path d="M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.463-8.413z" /></svg>
                WhatsApp direct
              </a>
            </div>
          </div>

          <div class="reveal rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-gray-900">Comment ça marche ?</h3>
            <ol class="mt-4 space-y-4">
              {
                steps.map((step) => (
                  <li class="flex gap-3">
                    <span class="font-display text-lg font-bold text-accent-700">{step.n}</span>
                    <span class="text-sm text-gray-600"><strong class="text-gray-900">{step.t}</strong><br />{step.d}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ
    eyebrow="Avant de demander"
    title="Tout savoir avant votre devis"
    subtitle="Les réponses aux questions que nos clients nous posent le plus souvent à Cotonou."
    items={faqItems}
  />

  <CTA
    title="Vous préférez en parler directement ?"
    subtitle="Un paysagiste vous répond au téléphone et prépare votre devis au même moment."
    primaryText="Appeler le 01 67 59 23 19"
    primaryHref="tel:+2290167592319"
    secondaryText="WhatsApp"
    secondaryHref="https://wa.me/22967592319"
  />
</Layout>

<script>
  const form = document.getElementById('devis-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/devis', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          alert('Votre demande de devis a été envoyée avec succès ! Nous vous répondons sous 24 heures.');
          form.reset();
        } else {
          alert('Une erreur est survenue. Veuillez réessayer ou nous appeler directement.');
        }
      } catch {
        alert('Une erreur est survenue. Veuillez réessayer ou nous appeler directement.');
      }
    });
  }
</script>
