---
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';
import { blogPosts } from '../../data/blog.js';
import { formatDate, byDateDesc } from '../../lib/date';

const categories = [
  { key: 'all', label: 'Tous' },
  { key: 'prix', label: 'Prix & Devis' },
  { key: 'conseils', label: 'Conseils' },
  { key: 'plantes', label: 'Plantes' },
  { key: 'entretien', label: 'Entretien' },
  { key: 'pelouse', label: 'Pelouse' },
  { key: 'inspiration', label: 'Inspiration' },
  { key: 'entreprises', label: 'Entreprises' },
  { key: 'traitement', label: 'Traitement' },
];

const readTime = (content: string) => Math.max(2, Math.ceil(content.split(/\s+/).length / 200));

/** Du plus récent au plus ancien. */
const posts = byDateDesc(blogPosts);
---

<Layout
  title="Conseils jardinage Cotonou | Blog BeClean"
  description="Blog de votre paysagiste à Cotonou. Conseils d'experts en jardinage, aménagement paysager, entretien de jardin, plantes tropicales. BeClean."
>
  <PageHeader
    badge="Blog & conseils"
    title="Conseils de jardinage à Cotonou"
    accent="par nos paysagistes"
    description="Prix, techniques d'entretien, choix des plantes et inspirations : les fiches pratiques de l'équipe BeClean pour réussir votre jardin au Bénin."
  />

  <section class="section-warm section-padding">
    <div class="container-custom">
      <!-- Filtres -->
      <div class="reveal mb-9 flex flex-wrap justify-center gap-2.5" role="group" aria-label="Filtrer les articles par catégorie">
        {categories.map((cat) => (
          <button
            type="button"
            data-category={cat.key}
            aria-pressed={cat.key === 'all' ? 'true' : 'false'}
            class:list={[
              'rounded-full px-4 py-2.5 text-sm font-medium transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600',
              cat.key === 'all'
                ? 'bg-primary-600 text-white shadow-[0_10px_24px_-16px_rgb(45_100_40/0.9)]'
                : 'border border-gray-200 bg-white text-gray-700 hover:border-primary-500 hover:text-primary-700',
            ]}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Grille d'articles -->
      <div class="stagger grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group reveal flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white transition-all duration-300 hover:-translate-y-1.5 hover:border-accent-500/50 hover:shadow-[0_28px_56px_-32px_rgb(16_24_40/0.45)]"
            data-cat={post.category.toLowerCase()}
          >
            <div class="relative aspect-video overflow-hidden bg-primary-100">
              <Img
                src={post.image}
                alt={post.title}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
                sizes="carteSm" />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-950/50 via-transparent to-transparent" aria-hidden="true"></div>
              <span class="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-primary-800">
                {post.category}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
                <span class="inline-flex items-center gap-2">
                  <svg class="h-3.5 w-3.5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                </span>
                <span class="text-gray-300" aria-hidden="true">·</span>
                <span class="inline-flex items-center gap-2">
                  <svg class="h-3.5 w-3.5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {readTime(post.content)} min
                </span>
              </p>

              <h2 class="mt-2 font-display text-lg leading-snug text-gray-900 transition-colors group-hover:text-primary-700">
                {post.title}
              </h2>
              <span class="mt-3 block h-px w-10 bg-accent-500 transition-all duration-300 group-hover:w-16" aria-hidden="true"></span>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">{post.excerpt}</p>

              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">
                Lire l'article
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section-forest relative overflow-hidden text-white">
    <svg class="leaf-decor leaf-decor-gold absolute -right-16 -top-20 w-64 rotate-[150deg]" viewBox="0 0 200 200" fill="currentColor" aria-hidden="true">
      <path d="M100 8c42 26 66 62 66 104 0 42-30 76-66 80-36-4-66-38-66-80C34 70 58 34 100 8zm0 24c-28 20-44 48-44 78 0 30 18 54 44 58 26-4 44-28 44-58 0-30-16-58-44-78z" />
    </svg>

    <div class="container-custom relative stagger py-14 md:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow eyebrow-light reveal justify-center">Newsletter</span>
        <h2 data-split class="mt-3 text-3xl leading-tight md:text-4xl">Recevez nos conseils jardinage</h2>
        <p class="reveal mt-4 leading-relaxed text-white/75">
          Un e-mail mensuel : calendrier des travaux, plantes de saison et astuces d'entretien pour le climat béninois.
        </p>

        <form class="reveal mt-7 flex flex-col justify-center gap-3 sm:flex-row" data-newsletter>
          <label class="sr-only" for="nl-email">Votre adresse e-mail</label>
          <input
            id="nl-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Votre adresse e-mail"
            class="w-full flex-1 rounded-full border border-white/15 bg-white/10 px-5 py-3.5 text-white placeholder:text-white/55 focus:border-accent-400 focus:outline-none sm:max-w-sm"
          />
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <input type="hidden" name="ts" value="" />
          <button type="submit" class="btn-gold justify-center">Je m'inscris</button>
        </form>
        <p class="reveal mt-4 text-sm text-white/60" data-newsletter-msg hidden></p>
      </div>
    </div>
  </section>

  <CTA
    title="Nos conseils vous inspirent ?"
    subtitle="Parlons de votre espace extérieur : étude gratuite et devis sous 24h."
    primaryText="Demander un devis gratuit"
    primaryHref="/devis"
    secondaryText="Découvrir nos services"
    secondaryHref="/services"
  />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('[data-category]');
  const posts = document.querySelectorAll<HTMLElement>('[data-cat]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('bg-primary-600', 'text-white');
        b.classList.add('border', 'border-gray-200', 'bg-white', 'text-gray-700');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('border', 'border-gray-200', 'bg-white', 'text-gray-700');
      btn.classList.add('bg-primary-600', 'text-white');
      btn.setAttribute('aria-pressed', 'true');

      const cat = btn.getAttribute('data-category') ?? 'all';
      posts.forEach((post) => {
        const match = cat === 'all' || (post.getAttribute('data-cat') || '').includes(cat);
        post.style.display = match ? '' : 'none';
      });
      if (typeof window.sweepMotion === 'function') window.sweepMotion();
    });
  });

  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  if (form) {
    const msg = document.querySelector<HTMLElement>('[data-newsletter-msg]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const tsField = form.querySelector<HTMLInputElement>('input[name="ts"]');
    if (tsField) tsField.value = String(Date.now());

    const show = (text: string, tone: 'ok' | 'error') => {
      if (!msg) return;
      msg.hidden = false;
      msg.textContent = text;
      msg.className = `mt-4 text-sm ${tone === 'ok' ? 'text-emerald-200' : 'text-amber-200'}`;
    };

    const setLoading = (loading: boolean) => {
      if (!button) return;
      button.disabled = loading;
      if (loading) {
        button.innerHTML = '<svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Envoi…';
      } else {
        button.textContent = "Je m'inscris";
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const payload = Object.fromEntries(new FormData(form).entries());
      setLoading(true);
      if (msg) msg.hidden = true;
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (res.ok && data.ok) {
          show('Merci ! Votre inscription est bien enregistrée.', 'ok');
          form.reset();
          if (tsField) tsField.value = String(Date.now());
        } else {
          show(data.error || "L'inscription a échoué. Merci de réessayer.", 'error');
        }
      } catch {
        show('Connexion impossible. Merci de réessayer dans un instant.', 'error');
      } finally {
        setLoading(false);
      }
    });
  }
</script>
