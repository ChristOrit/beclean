---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
---

<Layout
  title="Paysagiste Entreprises Cotonou | Espaces verts hôtel | Be Clean"
  description="Aménagement paysager pour entreprises et hôtels à Cotonou. Contrats d'entretien, espaces verts professionnels. Devis gratuit."
>
  <PageHeader
    badge="Secteurs · Entreprises"
    title="Nos services pour les entreprises"
    accent="hôtels & commerces"
    description="Aménagement et entretien d'espaces verts pour entreprises, hôtels, restaurants et copropriétés à Cotonou : contrats, rapports d'intervention et équipes dédiées."
  />

  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 data-split class="text-3xl font-bold text-gray-900 mb-6">Valorisez votre image professionnelle</h2>
        <p class="reveal text-lg text-gray-600 leading-relaxed mb-6">
          Vos espaces verts sont la première impression que vous donnez à vos clients, partenaires et collaborateurs. Un jardin négligé envoie un message négatif sur votre attention aux détails. À l'inverse, des espaces soignés renforcent votre image de professionnalisme et de sérieux.
        </p>

        <h2 data-split class="text-3xl font-bold text-gray-900 mb-6 mt-12">Nos services pour entreprises</h2>
        <ul class="space-y-4 text-lg text-gray-600 stagger">
          <li class="reveal flex items-start gap-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong>Conception d'espaces verts professionnels</strong> — Aménagement adapté à votre image de marque.</span>
          </li>
          <li class="reveal flex items-start gap-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong>Contrats d'entretien</strong> — Entretien régulier avec équipes dédiées.</span>
          </li>
          <li class="reveal flex items-start gap-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong>Aménagement de parcs et jardins d'entreprise</strong> — Espaces verts pour campus et sièges sociaux.</span>
          </li>
          <li class="reveal flex items-start gap-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong>Jardins d'hôtels</strong> — Aménagement paysager pour hôtels et resorts.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <FAQ
    items={[
    {
      question: "Proposez-vous des contrats d'entretien pour les entreprises ?",
      answer: "Oui, avec passages planifiés, interlocuteur dédié, facturation mensuelle et rapports d'intervention pour vos services techniques ou immobiliers."
    },
    {
      question: "Travaillez-vous avec les hôtels et restaurants ?",
      answer: "Oui : jardins d'accueil, terrasses, parkings ombragés et espaces piscine. Nous nous adaptons aux horaires d'ouverture pour ne jamais perturber votre activité."
    },
    {
      question: "Fournissez-vous les attestations nécessaires aux marchés ?",
      answer: "Oui : assurance professionnelle, extrait d'immatriculation et références de chantiers sont fournis sur demande."
    },
    ]}
    subtitle="Questions fréquentes de nos clients {'« particuliers »' if False else ''}."
  />

  <CTA
    title="Un contrat d'entretien, c'est la tranquillité d'esprit"
    subtitle="Demandez une proposition commerciale à Be Clean : réponse sous 24h."
    secondaryText="Voir nos réalisations"
    secondaryHref="/realisations"
  />

</Layout>
