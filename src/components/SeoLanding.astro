---
import PageHeader from './PageHeader.astro';
import CTA from './CTA.astro';
import FAQ from './FAQ.astro';

interface Props {
  badge: string;
  title: string;
  accent?: string;
  description: string;
  steps?: { title: string; text: string }[];
  benefits?: { title: string; text: string }[];
  faq?: { question: string; answer: string }[];
  related?: { href: string; label: string; text: string }[];
  ctaTitle: string;
  ctaSubtitle?: string;
}

const { badge, title, accent, description, steps, benefits, faq, related, ctaTitle, ctaSubtitle } = Astro.props;
---

<PageHeader badge={badge} title={title} accent={accent} description={description} />

<section class="section-padding bg-white">
  <div class="container-custom">
    <div class="rich mx-auto max-w-3xl">
      <slot />
    </div>
  </div>
</section>

{
  steps && steps.length > 0 && (
    <section class="section-warm section-padding">
      <div class="container-custom">
        <div class="reveal mb-10 text-center md:mb-12">
          <span class="eyebrow justify-center">Méthode Be Clean</span>
          <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Comment nous menons votre projet</h2>
        </div>
        <div class="stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((step, i) => (
            <article class="step-card reveal">
              <span class="font-display text-3xl font-bold text-accent-700">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-lg font-semibold text-gray-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  benefits && benefits.length > 0 && (
    <section class="section-padding bg-white">
      <div class="container-custom">
        <div class="reveal mb-10 text-center md:mb-12">
          <span class="eyebrow justify-center">Pourquoi Be Clean</span>
          <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Les avantages de notre accompagnement</h2>
        </div>
        <div class="stagger grid gap-5 md:grid-cols-3">
          {benefits.map((item) => (
            <div class="rounded-2xl border border-gray-100 bg-primary-50/60 p-6 reveal">
              <span class="mb-4 grid h-11 w-11 place-items-center rounded-full bg-white text-primary-700 shadow-sm">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <h3 class="text-lg font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  related && related.length > 0 && (
    <section class="section-padding bg-gray-50">
      <div class="container-custom">
        <div class="reveal mb-8 text-center">
          <span class="eyebrow justify-center">Aller plus loin</span>
          <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Pages liées</h2>
        </div>
        <div class="stagger flex flex-wrap justify-center gap-3">
          {related.map((item) => (
            <a href={item.href} class="chip-link reveal" title={item.text}>
              {item.label}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

{faq && faq.length > 0 && <FAQ items={faq} subtitle="Les réponses aux questions les plus fréquentes de nos clients à Cotonou." />}

<CTA title={ctaTitle} subtitle={ctaSubtitle} secondaryText="Voir nos réalisations" secondaryHref="/realisations" />
