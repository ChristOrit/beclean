---

<footer class="footer-bg relative overflow-hidden text-gray-300">
  <!-- Bandeau de conversion -->
  <div class="border-b border-white/10">
    <div class="container-custom flex flex-col gap-6 py-9 md:flex-row md:items-center md:justify-between md:py-10">
      <div class="reveal">
        <span class="eyebrow eyebrow-light">Un projet en tête&nbsp;?</span>
        <p class="mt-3 max-w-xl font-display text-2xl leading-snug text-white md:text-[1.7rem]">
          Parlons de votre jardin — <span class="text-accent-400">devis gratuit sous 24h</span>.
        </p>
      </div>
      <div class="reveal flex flex-wrap gap-3">
        <a href="tel:+2290167592319" class="btn-gold">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          01 67 59 23 19
        </a>
        <a href="https://wa.me/22967592319" class="btn-ghost" rel="noopener">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
        <a href="/devis" class="btn-ghost">Demander un devis</a>
      </div>
    </div>
  </div>

  <!-- Colonnes -->
  <div class="container-custom grid gap-10 py-14 md:grid-cols-2 md:gap-x-8 lg:grid-cols-12 lg:gap-x-10 lg:py-16">
    <!-- Marque -->
    <div class="reveal lg:col-span-4">
      <Logo class="h-14 w-auto" />
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-gray-400">
        <strong class="font-semibold text-white">Du rêve à la réalité, en toute harmonie.</strong>
        Paysagiste à Cotonou depuis 2013 : conception, création et entretien de jardins
        tropicaux pour particuliers, hôtels et entreprises.
      </p>

      <div class="mt-6 flex gap-3">
        {socials.map((social) => (
          <a
            href={social.href}
            aria-label={social.label}
            class="grid h-10 w-10 place-items-center rounded-full border border-white/10 bg-white/5 text-gray-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-400/60 hover:text-accent-400"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={social.path} />
            </svg>
          </a>
        ))}
      </div>

      <div class="mt-6 flex flex-wrap gap-4 text-sm">
        <div class="flex items-center gap-3">
          <span class="font-display text-2xl font-bold text-accent-400">13+</span>
          <span class="leading-tight text-gray-400">années<br />d'expérience</span>
        </div>
        <span class="w-px bg-white/10" aria-hidden="true"></span>
        <div class="flex items-center gap-3">
          <span class="font-display text-2xl font-bold text-accent-400">50+</span>
          <span class="leading-tight text-gray-400">projets<br />livrés</span>
        </div>
      </div>
    </div>

    <!-- Services -->
    <div class="reveal lg:col-span-2">
      <h2 class="footer-title">Nos services</h2>
      <ul class="space-y-3 text-sm">
        {services.map((item) => (
          <li><a href={item.href} class="footer-link cursor-pointer text-gray-400">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Expertises -->
    <div class="reveal lg:col-span-2">
      <h2 class="footer-title">Nos expertises</h2>
      <ul class="space-y-3 text-sm">
        {expertises.map((item) => (
          <li><a href={item.href} class="footer-link cursor-pointer text-gray-400">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Navigation -->
    <div class="reveal lg:col-span-2">
      <h2 class="footer-title">Navigation</h2>
      <ul class="space-y-3 text-sm">
        {navigation.map((item) => (
          <li><a href={item.href} class="footer-link cursor-pointer text-gray-400">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div class="reveal lg:col-span-2">
      <h2 class="footer-title">Contact</h2>
      <div class="footer-panel space-y-4 text-sm">
        <p class="flex items-start gap-3 text-gray-300">
          <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Rue 12.045, Haie Vive<br />Cotonou, Bénin</span>
        </p>
        <p class="flex items-center gap-3">
          <svg class="h-4 w-4 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <a href="tel:+2290167592319" class="footer-link cursor-pointer text-gray-300">+229 01 67 59 23 19</a>
        </p>
        <p class="flex items-center gap-3 break-all">
          <svg class="h-4 w-4 flex-shrink-0 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <a href="mailto:oritchrist@gmail.com" class="footer-link cursor-pointer text-gray-300">oritchrist@gmail.com</a>
        </p>
        <p class="border-t border-white/10 pt-4 text-xs leading-relaxed text-gray-400">
          Lun – Ven : 08h00 – 18h00<br />Sam : 09h00 – 13h00
        </p>
      </div>
    </div>
  </div>

  <!-- Zones desservies -->
  <div class="border-t border-white/10">
    <div class="container-custom flex flex-wrap items-center gap-x-5 gap-y-3 py-6">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-400">
        Zones desservies
      </span>
      <div class="flex flex-wrap gap-2">
        {zones.map((zone) => (
          <span class="footer-pill">{zone}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Barre basse -->
  <div class="border-t border-white/10">
    <div class="container-custom flex flex-col gap-3 py-6 text-xs text-gray-400 md:flex-row md:items-center md:justify-between">
      <p>&copy; {currentYear} Be Clean — Tous droits réservés. — <a href="/contact" class="inline-block cursor-pointer py-2.5 transition-colors hover:text-accent-400">Mentions & contact</a></p>
      <p class="md:text-right">
        Paysagiste Cotonou · Aménagement paysager · Jardinier · Jardinage ·
        Porto-Novo · Parakou · Création de jardins Bénin
      </p>
    </div>
  </div>
</footer>

<a href="https://wa.me/22967592319" aria-label="Contacter Be Clean sur WhatsApp" class="float-soft fixed bottom-6 right-6 z-50 flex cursor-pointer items-center gap-2 rounded-full bg-green-700 px-4 py-3 text-white shadow-lg transition-colors hover:bg-green-800">
