---
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/services', label: 'Services' },
  { href: '/realisations', label: 'Réalisations' },
  { href: '/boutique', label: 'Boutique' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center" aria-label="Be Clean - Accueil">
        <Logo class="h-14 md:h-16 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:text-primary-600={isActive(link.href)}
            class:text-gray-600={!isActive(link.href)}
            class:hover:text-primary-600={!isActive(link.href)}
            class:font-medium={true}
            class:text-sm={true}
            class:transition-colors={true}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-4">
        <a href="tel:+2290167592319" class="flex items-center gap-2 text-sm font-semibold text-primary-700 bg-primary-50 px-4 py-2 rounded-full hover:bg-primary-100 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          01 67 59 23 19
        </a>
        <a href="/devis" class="bg-primary-600 text-white text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-primary-700 transition-colors">Devis gratuit</a>
      </div>

      <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-600 hover:text-primary-600" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden bg-white border-t">
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:text-primary-600={isActive(link.href)}
          class:text-gray-600={!isActive(link.href)}
          class:font-medium={true}
          class:py-2={true}
        >
          {link.label}
        </a>
      ))}
      <a href="/devis" class="bg-primary-600 text-white text-sm font-semibold px-5 py-2.5 rounded-full text-center mt-2">Devis gratuit</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>

<style is:inline>
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-menu.is-open {
    grid-template-rows: 1fr;
  }
  .mobile-menu > nav {
    min-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s linear 0.3s;
  }
  .mobile-menu.is-open > nav {
    visibility: visible;
    transition-delay: 0s;
  }
  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu > nav {
      transition-duration: 0.01ms !important;
    }
  }
</style>
