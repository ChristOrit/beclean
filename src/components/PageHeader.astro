---
interface Props {
  badge: string;
  title: string;
  description?: string;
  accent?: string;
}

const { badge, title, description, accent } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-primary-50 via-white to-white">
  <div class="pointer-events-none absolute -top-28 -right-24 h-80 w-80 rounded-full bg-accent-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-16 left-1/3 h-64 w-64 rounded-full bg-primary-500/10 blur-3xl" aria-hidden="true"></div>
  <svg class="leaf-decor absolute -bottom-10 right-4 w-44 rotate-[16deg] md:right-16 md:w-56" viewBox="0 0 200 200" fill="currentColor" aria-hidden="true">
    <path d="M100 8c42 26 66 62 66 104 0 42-30 76-66 80-36-4-66-38-66-80C34 70 58 34 100 8zm0 24c-28 20-44 48-44 78 0 30 18 54 44 58 26-4 44-28 44-58 0-30-16-58-44-78z" />
  </svg>

  <div class="container-custom relative stagger pb-14 pt-10 md:pb-20 md:pt-14">
    <nav aria-label="Fil d'Ariane" class="reveal flex flex-wrap items-center gap-2 text-sm">
      <a href="/" class="inline-flex cursor-pointer items-center gap-1.5 text-gray-500 transition-colors hover:text-primary-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11v11a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1m-4 0h4" />
        </svg>
        <span>Accueil</span>
      </a>
      <span class="text-gray-300" aria-hidden="true">/</span>
      <span class="font-medium text-gray-800">{badge}</span>
    </nav>

    <span class="eyebrow reveal mt-7">{badge}</span>

    <h1 data-split class="mt-3 max-w-3xl text-balance text-3xl leading-[1.12] text-gray-900 md:text-5xl">
      {title}{accent && <span class="accent"> {accent}</span>}
    </h1>

    <span class="rule-leaf start reveal mt-6"></span>

    {description && <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">{description}</p>}
  </div>

  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-accent-500/50 to-transparent" aria-hidden="true"></div>
</section>
