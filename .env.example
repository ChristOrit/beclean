# ── Studio badges (Neon + accès protégé) ─────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>
BADGES_STUDIO_PWD=<mot-de-passe-studio>
BADGES_STUDIO_SECRET=<secret-hmac-optionnel-dérivé-du-mot-de-passe>

# ── E-mails contact / devis (Resend) ─────────────────────
RESEND_API_KEY=<clé-api-resend>
RESEND_FROM=BeClean <onboarding@resend.dev>
LEADS_TO_EMAIL=<email-de-destination-des-leads>

# ── Newsletter (Brevo) ───────────────────────────────────
BREVO_API_KEY=<clé-api-brevo-xkeysib-...>
BREVO_LIST_ID=<identifiant-liste-brevo>
